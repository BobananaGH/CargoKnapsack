/* gui/styles.qss */

/* -----------------------------------------
   Main window
----------------------------------------- */

QMainWindow {
    background-color: #f4f6f8;
}

QWidget {
    font-family: "Segoe UI";
    font-size: 14px;
    color: #202124;
}


/* -----------------------------------------
   Group boxes
----------------------------------------- */

QGroupBox {
    background-color: white;
    border: 1px solid #d9dee3;
    border-radius: 8px;
    margin-top: 12px;
    padding: 18px 12px 12px 12px;
    font-size: 15px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}


/* -----------------------------------------
   Labels
----------------------------------------- */

QLabel {
    background: transparent;
}

#titleLabel {
    font-size: 28px;
    font-weight: bold;
}

#subtitleLabel {
    color: #6b7280;
    font-size: 14px;
}


/* -----------------------------------------
   Spin boxes
----------------------------------------- */

QSpinBox {
    background-color: white;
    border: 1px solid #cfd5db;
    border-radius: 5px;
    padding: 6px;
    min-width: 90px;
}

QSpinBox:focus {
    border: 1px solid #4f46e5;
}


/* -----------------------------------------
   Table
----------------------------------------- */

QTableWidget {
    background-color: white;
    border: 1px solid #d9dee3;
    border-radius: 6px;
    gridline-color: #e5e7eb;
    selection-background-color: #e0e7ff;
    selection-color: #111827;
    alternate-background-color: #f9fafb;
}

QHeaderView::section {
    background-color: #eef1f5;
    border: none;
    border-bottom: 1px solid #d9dee3;
    padding: 8px;
    font-weight: bold;
}

QTableWidget::item {
    padding: 6px;
}


/* -----------------------------------------
   Buttons
----------------------------------------- */

QPushButton {
    background-color: #e5e7eb;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #d1d5db;
}

QPushButton:pressed {
    background-color: #c4c9d0;
}


/* Optimize button */

#optimizeButton {
    background-color: #4f46e5;
    color: white;
    font-weight: bold;
    padding: 9px 24px;
}

#optimizeButton:hover {
    background-color: #4338ca;
}

#optimizeButton:pressed {
    background-color: #3730a3;
}


/* -----------------------------------------
   Result labels
----------------------------------------- */

#resultLabel {
    font-size: 15px;
    padding: 3px;
}

#profitLabel {
    font-size: 18px;
    font-weight: bold;
}